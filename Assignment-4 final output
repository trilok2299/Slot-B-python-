import csv
import os


DEPARTMENTS = ["CSE", "ECE", "EEE", "IT", "MECH"]
EVENTS = ["Dance", "Music", "Singing", "Drama"]


def valid_email(email):
    """Perform a basic email-format check."""
    if email.count("@") != 1:
        return False
    local, domain = email.split("@")
    return bool(local and domain and "." in domain and not domain.startswith("."))


def process_file(filename, display_name, seen, master, event_participants, errors):
    """Read and validate one department file, retaining valid registrations."""
    rejected = 0

    try:
        with open(filename, "r", encoding="utf-8", newline="") as source:
            reader = csv.reader(source, strict=True)
            while True:
                try:
                    row = next(reader)
                except StopIteration:
                    break
                except csv.Error as error:
                    line_number = max(reader.line_num, 1)
                    errors.append("{}, Line {}: Damaged record ({})".format(
                        display_name, line_number, error
                    ))
                    rejected += 1
                    continue

                line_number = reader.line_num
                try:
                    if len(row) != 5:
                        raise ValueError("Expected exactly five fields")

                    registration = [field.strip() for field in row]
                    reg_number, name, department, email, chosen_events = registration

                    if not reg_number or not name or not department or not email:
                        raise ValueError("Required field is empty")
                    if not valid_email(email):
                        raise ValueError("Invalid email")
                    if reg_number in seen:
                        raise ValueError("Duplicate registration")

                    seen.add(reg_number)
                    master.append(registration)

                    for event in chosen_events.split(";"):
                        event = event.strip()
                        if event:
                            event_participants.setdefault(event, []).append(
                                [reg_number, name, department]
                            )
                except (ValueError, IndexError) as error:
                    errors.append("{}, Line {}: {}".format(
                        display_name, line_number, error
                    ))
                    rejected += 1

    except FileNotFoundError:
        errors.append("{}: Missing department file".format(display_name))
    except PermissionError:
        errors.append("{}: Permission denied".format(display_name))
    except OSError as error:
        errors.append("{}: File error ({})".format(display_name, error))

    return rejected


def write_reports(output_dir, master, event_participants, errors, rejected):
    """Write the master list, event lists, summary, and error log."""
    if not os.path.isdir(output_dir):
        os.makedirs(output_dir)

    with open(os.path.join(output_dir, "master.csv"), "w", encoding="utf-8", newline="") as target:
        writer = csv.writer(target)
        writer.writerows(master)

    for event in EVENTS:
        event_participants.setdefault(event, [])

    for event, participants in event_participants.items():
        filename = "{}.txt".format(event)
        with open(os.path.join(output_dir, filename), "w", encoding="utf-8", newline="") as target:
            writer = csv.writer(target)
            writer.writerows(participants)

    with open(os.path.join(output_dir, "summary.txt"), "w", encoding="utf-8") as target:
        target.write("Valid registrations: {}\n".format(len(master)))
        target.write("Rejected records: {}\n".format(rejected))
        target.write("Event participants:\n")
        for event in sorted(event_participants):
            target.write("{}: {}\n".format(event, len(event_participants[event])))

    with open(os.path.join(output_dir, "error.log"), "w", encoding="utf-8") as target:
        if errors:
            target.write("\n".join(errors) + "\n")


def main():
    base_dir = os.path.dirname(os.path.abspath(__file__))
    input_dir = os.path.join(base_dir, "input")
    output_dir = os.path.join(base_dir, "output")

    seen = set()
    master = []
    event_participants = {}
    errors = []
    rejected = 0

    for department in DEPARTMENTS:
        filename = os.path.join(input_dir, department + ".txt")
        display_name = "input/{}.txt".format(department)
        rejected += process_file(
            filename, display_name, seen, master, event_participants, errors
        )

    write_reports(output_dir, master, event_participants, errors, rejected)
    print("Fest registration processing completed")
    print("Valid Registrations: {}".format(len(master)))
    print("Rejected Records: {}".format(rejected))


if __name__ == "__main__":
    main()
